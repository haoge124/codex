{
  "manifest_version": 3,
  "name": "ChatGPT 右键翻译为中文",
  "version": "1.0.0",
  "description": "选中文本后右键，直接用已登录的 ChatGPT 翻译为中文。",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "ChatGPT 翻译"
  }
}
